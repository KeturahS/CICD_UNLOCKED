@csrf_protect
def login_view(request):
    form = LoginForm(request.POST or None)
    msg = None
    if request.method == 'POST':
        if form.is_valid():
            username = form.cleaned_data.get('username')
            password = form.cleaned_data.get('password')
            user = authenticate(username=username, password=password)
            print(user)
            if user is not None:
                if user.is_active:
                    if user.is_lecturer:
                        login(request, user)
                        return redirect('lecturer')

                    if user.is_admin:
                        login(request, user)
                        return redirect('admin')

                    if user.is_student:
                        login(request, user)
                        return redirect('student')

                if not user.is_active:
                    if user.is_lecturer:
                        msg = 'בקשתך להירשם כמרצה טרם אושרה, אנא המתן בסבלנות לתשובה מצוות האתר'

                    if user.is_admin:
                        msg = 'בקשתך להירשם כמנהל טרם אושרה, אנא המתן בסבלנות לתשובת המנהל הבכיר'

                    return render(request, 'login.html')
            else:
                msg = 'פרטים לא נכונים '

        else:
            msg = 'טופס לא תקין'
    return render(request, 'RegisterAndLogin/login.html', {'form': form, 'msg': msg})


