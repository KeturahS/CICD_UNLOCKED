<!doctype html>
{% load static %}
<html lang="he" dir="rtl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>כניסת משתמשים</title>
</head>
<body>
<div class="container d-flex justify-content-center align-items-center min-vh-100">
    <div class="col-md-6">
        <div class="card p-4 shadow-lg">
            <h2 class="text-center mb-4">כניסת משתמשים</h2>
            <span class="mb-0 text-muted">
                {% if msg %}
                    {{ msg | safe }}
                {% else %}
                    עמוד התחברות
                {% endif %}
            </span>
            <form method="post" autocomplete="off" novalidate>
                {% csrf_token %}



                <div class="mb-3">
                    <label for="username" class="form-label">שם משתמש </label>
                    {{ form.username }}
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">סיסמה</label>
                    {{ form.password }}
                </div>

                <div class="d-flex justify-content-between">
                <p><a href="{% url 'password_reset' %}">שכחתי סיסמה</a></p>
                    <input type="submit" value="התחבר" class="btn btn-primary">
                </div>
            </form>
        </div>
    </div>
</div>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>